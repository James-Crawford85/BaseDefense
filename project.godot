; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="BaseDefense"
config/version="0.2.5"
run/main_scene="res://scenes/main/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

Game="*res://scripts/game.gd"
Fx="*res://scripts/fx.gd"
Audio="*res://scripts/audio.gd"
Sfx="*res://scripts/sfx.gd"
Net="*res://scripts/net.gd"
Updater="*res://scripts/updater.gd"

[display]

window/size/viewport_width=1020
window/size/viewport_height=573
window/size/mode=3
window/stretch/mode="canvas_items"

